---
interface Props {
  number: number;
  title: string;
  summary: string;
  bookSlug: string;
  slug: string;
}
const { number, title, summary, bookSlug, slug } = Astro.props;
---
<article class="card chapter-card" data-number={String(number).padStart(2, '0')}>
  <span class="chapter-number">Capítulo {String(number).padStart(2, '0')}</span>
  <h3><a href={`/${bookSlug}/${slug}`}>{title}</a></h3>
  <p>{summary}</p>
  <a href={`/${bookSlug}/${slug}`} data-track="capitulo_aberto" data-track-label={title}>Explorar capítulo →</a>
</article>
