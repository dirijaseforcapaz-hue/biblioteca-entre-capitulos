---
interface Props {
  number: number;
  title: string;
  summary: string;
  bookSlug: string;
  slug: string;
  hasMap?: boolean;
}
const { number, title, summary, bookSlug, slug, hasMap = false } = Astro.props;
---
<article class="card chapter-card" data-number={String(number).padStart(2, '0')}>
  <span class="chapter-number">Capítulo {String(number).padStart(2, '0')}</span>
  <h3><a href={`/${bookSlug}/${slug}`}>{title}</a></h3>
  <p>{summary}</p>
  <div class="chapter-meta">
    <span class="chapter-meta-pill">Resumo visual</span>
    {hasMap && <span class="chapter-meta-pill is-map">Mapa mental</span>}
  </div>
  <a href={`/${bookSlug}/${slug}`} data-track="capitulo_aberto" data-track-label={title}>Explorar capítulo →</a>
</article>
