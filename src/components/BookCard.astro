---
interface Props {
  title: string;
  author: string;
  description: string;
  cover: string;
  slug: string;
  category: string;
  chapterCount: number;
  totalChapters: number;
  status?: 'publicado' | 'em-producao' | 'planejado';
  accent?: string;
}
const { title, author, description, cover, slug, category, chapterCount, totalChapters, status = 'publicado', accent = 'sage' } = Astro.props;
const progress = Math.min(100, Math.round((chapterCount / Math.max(totalChapters, 1)) * 100));
const statusLabel = status === 'em-producao' ? 'Coleção em andamento' : status === 'planejado' ? 'Em breve' : 'Coleção publicada';
const noPublishedYet = chapterCount === 0 && status === 'em-producao';
---
<article class:list={['card', 'book-card', accent === 'atomic' && 'book-card-atomic']}>
  <a class="book-card-cover" href={`/livros/${slug}`} aria-label={`Abrir ${title}`} data-track="livro_aberto" data-track-label={title}>
    <img src={cover} alt={`Capa de ${title}, de ${author}`} loading="lazy" width="280" height="380" />
  </a>
  <div class="book-card-body">
    <div class="book-card-topline">
      <span class="eyebrow">{category}</span>
      <span class="status-dot"><i aria-hidden="true"></i>{statusLabel}</span>
    </div>
    <h3><a href={`/livros/${slug}`}>{title}</a></h3>
    <p class="book-author">{author}</p>
    <p class="book-card-description">{description}</p>
    <div class="collection-progress" aria-label={noPublishedYet ? `${totalChapters} capítulos planejados` : `${chapterCount} de ${totalChapters} capítulos publicados`}>
      <div class="collection-progress-copy">
        {noPublishedYet ? <><strong>{totalChapters}</strong><span>capítulos estruturados</span></> : <><strong>{chapterCount} de {totalChapters}</strong><span>capítulos publicados</span></>}
      </div>
      {!noPublishedYet && <div class="collection-progress-track"><span style={`width:${progress}%`}></span></div>}
    </div>
    <div class="book-card-actions"><a class="text-link" href={`/livros/${slug}`} data-track="livro_aberto" data-track-label={title}>Explorar coleção <span aria-hidden="true">→</span></a></div>
  </div>
</article>
