---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Início' },
  { href: '/livros', label: 'Livros' },
  { href: '/sobre', label: 'Sobre' }
];
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Biblioteca Entre Capítulos - página inicial">
      <span class="brand-logo" aria-hidden="true">
        <img src="/images/brand/entre-capitulos-monograma.jpg" alt="" width="420" height="420" />
      </span>
      <span class="brand-copy"><strong>Biblioteca Entre Capítulos</strong><small>Entre Capítulos</small></span>
    </a>

    <nav class="nav" aria-label="Navegação principal">
      {links.map((link) => (
        <a href={link.href} aria-current={path === link.href || (link.href !== '/' && path.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <details class="mobile-menu">
      <summary aria-label="Abrir menu"><span>Menu</span></summary>
      <nav class="mobile-menu-panel" aria-label="Navegação móvel">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
