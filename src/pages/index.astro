---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import ChapterCard from '../components/ChapterCard.astro';

const books = (await getCollection('livros')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const chapters = (await getCollection('capitulos')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const featuredBook = books.find((book) => book.data.featured) ?? books[0];
const featuredBookChapters = featuredBook ? chapters.filter((chapter) => chapter.data.bookSlug === featuredBook.data.slug) : [];
const firstFeaturedChapter = featuredBookChapters.sort((a, b) => a.data.number - b.data.number)[0];
const chapterByNumber = new Map(featuredBookChapters.map((chapter) => [chapter.data.number, chapter]));
const outlinePreview = featuredBook?.data.chapterOutline.slice(0, 4) ?? [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Biblioteca Entre Capítulos',
  url: 'https://bibliotecaentrecapitulos.com.br',
  description: 'Resumos visuais, mapas mentais e análises de grandes livros, capítulo por capítulo.'
};
---
<BaseLayout
  title="Biblioteca Entre Capítulos"
  description="Grandes livros transformados em experiências visuais de aprendizado: resumos, mapas, conexões e aplicações capítulo por capítulo."
  jsonLd={jsonLd}
>
  <section class="hero hero-v2">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Biblioteca visual de grandes ideias</p>
        <h1>Entenda o livro.<br /><em>Guarde as ideias.</em></h1>
        <p class="lead">Grandes livros transformados em experiências visuais de aprendizado. Leia a análise, conecte os conceitos, revise pelo mapa e aprofunde no episódio.</p>
        <div class="hero-actions">
          {firstFeaturedChapter ? (
            <a class="btn btn-primary" href={`/${firstFeaturedChapter.data.bookSlug}/${firstFeaturedChapter.data.slug}`} data-track="cta_continuar_leitura">Começar pela coleção <span aria-hidden="true">→</span></a>
          ) : (
            <a class="btn btn-primary" href="/livros" data-track="cta_explorar_biblioteca">Explorar a biblioteca <span aria-hidden="true">→</span></a>
          )}
          <a class="btn btn-secondary" href="/livros">Ver todos os livros</a>
        </div>
        <p class="hero-note"><span aria-hidden="true">●</span> Conteúdo editorial independente, pensado para complementar a leitura das obras.</p>
      </div>

      {featuredBook && (
        <div class="product-showcase" aria-label={`Coleção em destaque: ${featuredBook.data.title}`}>
          <div class="showcase-head">
            <div class="showcase-cover-wrap"><img src={featuredBook.data.cover} alt={`Capa de ${featuredBook.data.title}, de ${featuredBook.data.author}`} class="showcase-cover" /></div>
            <div class="showcase-book-meta">
              <span class="micro-label">Coleção em andamento</span>
              <strong>{featuredBook.data.title}</strong>
              <span>{featuredBook.data.author}</span>
              <div class="mini-progress" aria-label={`${featuredBookChapters.length} de ${featuredBook.data.totalChapters} capítulos publicados`}>
                <div><b>{featuredBookChapters.length}/{featuredBook.data.totalChapters}</b><span> capítulos</span></div>
                <i><span style={`width:${Math.round((featuredBookChapters.length / featuredBook.data.totalChapters) * 100)}%`}></span></i>
              </div>
            </div>
          </div>

          <div class="showcase-chapters">
            {outlinePreview.map((item) => {
              const published = chapterByNumber.get(item.number);
              return published ? (
                <a href={`/${published.data.bookSlug}/${published.data.slug}`} class="showcase-chapter is-live">
                  <span class="chapter-index">{String(item.number).padStart(2, '0')}</span>
                  <span><strong>{item.title}</strong><small>Disponível agora</small></span>
                  <b aria-hidden="true">→</b>
                </a>
              ) : (
                <div class="showcase-chapter is-next">
                  <span class="chapter-index">{String(item.number).padStart(2, '0')}</span>
                  <span><strong>{item.title}</strong><small>Em preparação</small></span>
                  <b aria-hidden="true">·</b>
                </div>
              );
            })}
          </div>

          {firstFeaturedChapter?.data.mapImage && (
            <a class="showcase-map" href={`/${firstFeaturedChapter.data.bookSlug}/${firstFeaturedChapter.data.slug}#mapa`} aria-label="Ver o Mapa Entre Capítulos">
              <img src={firstFeaturedChapter.data.mapImage} alt="Prévia do Mapa Entre Capítulos" />
              <span><small>Mapa Entre Capítulos</small><strong>Uma imagem para revisar a ideia.</strong></span>
            </a>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="section section-usage">
    <div class="container">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Uma biblioteca para voltar depois</p>
          <h2>Três maneiras de usar cada capítulo.</h2>
        </div>
        <p class="muted section-intro">Não é apenas um resumo para consumir uma vez. Cada página foi organizada para funcionar como leitura, revisão e aprofundamento.</p>
      </div>
      <div class="learning-path">
        <article class="learning-card">
          <span class="learning-number">01</span>
          <p class="micro-label">Quero entender</p>
          <h3>Leia a análise.</h3>
          <p>Comece pela ideia central, passe pelos conceitos e entenda como a parte se encaixa no argumento do livro.</p>
        </article>
        <article class="learning-card">
          <span class="learning-number">02</span>
          <p class="micro-label">Quero revisar</p>
          <h3>Volte ao mapa.</h3>
          <p>Use a síntese visual para recuperar rapidamente relações, etapas e perguntas importantes daquele capítulo.</p>
        </article>
        <article class="learning-card">
          <span class="learning-number">03</span>
          <p class="micro-label">Quero aprofundar</p>
          <h3>Assista ao episódio.</h3>
          <p>Quando houver episódio publicado, a análise em vídeo fica integrada à mesma página para continuar o estudo.</p>
        </article>
      </div>
    </div>
  </section>

  {featuredBook && (
    <section class="section collections-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Coleções</p>
            <h2>Leia um livro por dentro.</h2>
          </div>
          <a class="text-link hide-mobile" href="/livros">Ver biblioteca completa <span aria-hidden="true">→</span></a>
        </div>
        <BookCard
          title={featuredBook.data.title}
          author={featuredBook.data.author}
          description={featuredBook.data.description}
          cover={featuredBook.data.cover}
          slug={featuredBook.data.slug}
          category={featuredBook.data.category}
          chapterCount={featuredBookChapters.length}
          totalChapters={featuredBook.data.totalChapters}
          status={featuredBook.data.status}
        />
      </div>
    </section>
  )}

  <section class="section latest-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Capítulos publicados</p>
          <h2>Escolha uma ideia e comece.</h2>
        </div>
      </div>
      {chapters.length > 0 ? (
        <div class="grid-3">
          {chapters.slice(0, 6).map((chapter) => (
            <ChapterCard
              number={chapter.data.number}
              title={chapter.data.title}
              summary={chapter.data.summary}
              bookSlug={chapter.data.bookSlug}
              slug={chapter.data.slug}
              hasMap={Boolean(chapter.data.mapImage)}
            />
          ))}
        </div>
      ) : <div class="empty-state">Os primeiros capítulos serão publicados em breve.</div>}
    </div>
  </section>

  <section class="manifesto-strip">
    <div class="container manifesto-inner">
      <span class="manifesto-mark" aria-hidden="true">EC</span>
      <div><p class="eyebrow">Entre Capítulos</p><h2>O vídeo passa. A biblioteca fica.</h2><p>Use o site como ponto de retorno para recuperar conceitos, mapas e conexões dos episódios.</p></div>
      <a class="btn btn-secondary" href="/sobre">Conhecer o projeto</a>
    </div>
  </section>
</BaseLayout>
