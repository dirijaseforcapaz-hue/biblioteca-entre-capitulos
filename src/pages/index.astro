---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterCard from '../components/ChapterCard.astro';

const books = (await getCollection('livros')).sort((a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime());
const chapters = (await getCollection('capitulos')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const bookBySlug = new Map(books.map((book) => [book.data.slug, book]));
const chaptersByBook = new Map(
  books.map((book) => [
    book.data.slug,
    chapters.filter((chapter) => chapter.data.bookSlug === book.data.slug).sort((a, b) => a.data.number - b.data.number)
  ])
);

const bookStats = books.map((book) => {
  const bookChapters = chaptersByBook.get(book.data.slug) ?? [];
  return {
    book,
    chapterCount: bookChapters.length,
    mapCount: bookChapters.filter((chapter) => Boolean(chapter.data.mapImage && chapter.data.mapDownloadUrl)).length
  };
});

const totalBooks = books.length;
const totalChapters = chapters.length;
const totalMaps = chapters.filter((chapter) => Boolean(chapter.data.mapImage && chapter.data.mapDownloadUrl)).length;
const completeCollections = bookStats.filter(({ book, chapterCount }) => book.data.status === 'publicado' && chapterCount === book.data.totalChapters).length;

const mixedChapters = [];
for (let index = 0; mixedChapters.length < 6; index += 1) {
  let added = false;
  for (const book of books) {
    const item = (chaptersByBook.get(book.data.slug) ?? [])[index];
    if (item && mixedChapters.length < 6) {
      mixedChapters.push(item);
      added = true;
    }
  }
  if (!added) break;
}

const featuredMaps = [];
for (const book of books) {
  const maps = (chaptersByBook.get(book.data.slug) ?? []).filter((chapter) => chapter.data.mapImage && chapter.data.mapDownloadUrl);
  if (maps.length > 0) featuredMaps.push(maps[0]);
  if (maps.length > 2) featuredMaps.push(maps[Math.floor(maps.length / 2)]);
}
const mapShowcase = featuredMaps.slice(0, 6);

const analysisVideos = books.map((book) => {
  const video = book.data.specialVideos.find((item) => /completa|completo|visão completa/i.test(`${item.eyebrow} ${item.title}`));
  return video ? { book, video } : null;
}).filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Biblioteca Entre Capítulos',
  url: 'https://bibliotecaentrecapitulos.com.br',
  description: 'Resumos visuais, mapas mentais e análises de grandes livros, capítulo por capítulo.'
};
---
<BaseLayout
  title="Biblioteca Entre Capítulos"
  description="Grandes livros transformados em análises visuais, mapas mentais e episódios, capítulo por capítulo."
  jsonLd={jsonLd}
>
  <section class="hero catalog-hero">
    <div class="container catalog-hero-grid">
      <div class="hero-copy catalog-hero-copy">
        <p class="eyebrow">Biblioteca Entre Capítulos</p>
        <h1>Grandes livros.<br /><em>Ideias que ficam.</em></h1>
        <p class="lead">Explore coleções completas com análises capítulo por capítulo, mapas mentais para revisão e episódios para aprofundar as ideias.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#catalogo" data-track="cta_explorar_catalogo">Explorar o catálogo <span aria-hidden="true">↓</span></a>
          <a class="btn btn-secondary" href="#mapas" data-track="cta_explorar_mapas">Ver mapas mentais</a>
        </div>
        <p class="hero-note"><span aria-hidden="true">●</span> Conteúdo editorial independente, complementar à leitura das obras.</p>
      </div>

      <div class="catalog-stage" aria-label="Coleções disponíveis na Biblioteca Entre Capítulos">
        <div class="catalog-stage-books">
          {bookStats.slice(0, 3).map(({ book, chapterCount, mapCount }, index) => (
            <a class:list={['catalog-stage-book', index === 1 && 'is-secondary']} href={`/livros/${book.data.slug}`} data-track="livro_aberto" data-track-label={book.data.title}>
              <div class:list={['catalog-stage-cover', book.data.accent === 'atomic' && 'is-atomic']}>
                <img src={book.data.cover} alt={`Capa de ${book.data.title}, de ${book.data.author}`} />
              </div>
              <div class="catalog-stage-meta">
                <strong>{book.data.title}</strong>
                <span>{book.data.author}</span>
                <small>{chapterCount} capítulos · {mapCount} mapas</small>
              </div>
            </a>
          ))}
        </div>
        <div class="catalog-stage-stats">
          <div><strong>{totalBooks}</strong><span>{totalBooks === 1 ? 'livro' : 'livros'}</span></div>
          <div><strong>{totalChapters}</strong><span>capítulos</span></div>
          <div><strong>{totalMaps}</strong><span>mapas</span></div>
        </div>
      </div>
    </div>
  </section>

  <section id="catalogo" class="section catalog-section">
    <div class="container">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Explore a biblioteca</p>
          <h2>Escolha o próximo livro.</h2>
        </div>
        <p class="muted section-intro">Cada coleção reúne capítulos, mapas e vídeos em um único lugar. O catálogo cresce livro por livro, sem transformar nenhuma obra em “principal”.</p>
      </div>

      <div class="catalog-books-grid">
        {bookStats.map(({ book, chapterCount, mapCount }) => (
          <article class:list={['catalog-book-card', book.data.accent === 'atomic' && 'is-atomic']}>
            <a class="catalog-book-cover" href={`/livros/${book.data.slug}`} aria-label={`Explorar ${book.data.title}`}>
              <img src={book.data.cover} alt={`Capa de ${book.data.title}, de ${book.data.author}`} loading="lazy" />
            </a>
            <div class="catalog-book-copy">
              <div class="catalog-book-topline"><span>{book.data.category}</span><b>{chapterCount === book.data.totalChapters ? 'Coleção completa' : 'Em produção'}</b></div>
              <h3><a href={`/livros/${book.data.slug}`}>{book.data.title}</a></h3>
              <p class="book-author">{book.data.author}</p>
              <p>{book.data.description}</p>
              <div class="catalog-book-facts">
                <span><strong>{chapterCount}</strong> capítulos</span>
                <span><strong>{mapCount}</strong> mapas</span>
                <span><strong>{chapterCount}</strong> análises</span>
              </div>
              <a class="text-link" href={`/livros/${book.data.slug}`} data-track="livro_aberto" data-track-label={book.data.title}>Explorar coleção <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section library-numbers-section">
    <div class="container library-numbers">
      <div><strong>{totalBooks}</strong><span>livros no catálogo</span></div>
      <div><strong>{totalChapters}</strong><span>capítulos analisados</span></div>
      <div><strong>{totalMaps}</strong><span>mapas para revisão</span></div>
      <div><strong>{completeCollections}</strong><span>coleções completas</span></div>
    </div>
  </section>

  <section class="section section-usage">
    <div class="container">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Escolha como explorar</p>
          <h2>A biblioteca não tem um único caminho.</h2>
        </div>
        <p class="muted section-intro">Entre por uma obra, por uma ideia específica ou pelos mapas quando quiser apenas revisar o essencial.</p>
      </div>
      <div class="learning-path">
        <article class="learning-card">
          <span class="learning-number">01</span>
          <p class="micro-label">Por livro</p>
          <h3>Explore coleções.</h3>
          <p>Veja a arquitetura de cada obra e percorra os capítulos na ordem ou escolha o assunto que mais interessa.</p>
          <a class="text-link" href="/livros">Ver todos os livros <span aria-hidden="true">→</span></a>
        </article>
        <article class="learning-card">
          <span class="learning-number">02</span>
          <p class="micro-label">Por capítulo</p>
          <h3>Encontre uma ideia.</h3>
          <p>Entre diretamente em conceitos, casos, aplicações e episódios sem precisar recomeçar o livro inteiro.</p>
          <a class="text-link" href="#capitulos">Ver capítulos <span aria-hidden="true">↓</span></a>
        </article>
        <article class="learning-card">
          <span class="learning-number">03</span>
          <p class="micro-label">Por mapa</p>
          <h3>Revise visualmente.</h3>
          <p>Abra o mapa no navegador ou baixe o PDF para recuperar rapidamente estruturas e relações importantes.</p>
          <a class="text-link" href="#mapas">Explorar mapas <span aria-hidden="true">↓</span></a>
        </article>
      </div>
    </div>
  </section>

  <section id="mapas" class="section home-maps-section">
    <div class="container">
      <div class="section-heading split-heading">
        <div><p class="eyebrow">Mapas Entre Capítulos</p><h2>Uma imagem para voltar à ideia.</h2></div>
        <p class="muted section-intro">Todos os mapas exibidos abaixo também têm PDF para download dentro da página do capítulo.</p>
      </div>
      <div class="home-map-grid">
        {mapShowcase.map((chapter) => {
          const book = bookBySlug.get(chapter.data.bookSlug);
          return (
            <article class="home-map-card">
              <a class="home-map-preview" href={`/${chapter.data.bookSlug}/${chapter.data.slug}#mapa`} data-track="mapa_aberto" data-track-label={chapter.data.title}>
                <img src={chapter.data.mapImage} alt={chapter.data.mapAlt ?? `Mapa de ${chapter.data.title}`} loading="lazy" />
              </a>
              <div class="home-map-copy">
                <small>{book?.data.title}</small>
                <strong>{chapter.data.title}</strong>
                <div><a href={`/${chapter.data.bookSlug}/${chapter.data.slug}#mapa`}>Abrir mapa</a><a href={chapter.data.mapDownloadUrl} download>PDF ↓</a></div>
              </div>
            </article>
          );
        })}
      </div>
      <div class="section-cta-center"><a class="btn btn-secondary" href="/livros">Ver mapas por coleção</a></div>
    </div>
  </section>

  <section id="capitulos" class="section latest-section">
    <div class="container">
      <div class="section-heading split-heading">
        <div><p class="eyebrow">Comece por uma ideia</p><h2>Capítulos de diferentes coleções.</h2></div>
        <p class="muted section-intro">Uma seleção misturada para a Home não ficar dominada por um único livro.</p>
      </div>
      <div class="grid-3">
        {mixedChapters.map((chapter) => (
          <ChapterCard
            number={chapter.data.number}
            title={chapter.data.title}
            summary={chapter.data.summary}
            bookSlug={chapter.data.bookSlug}
            slug={chapter.data.slug}
            hasMap={Boolean(chapter.data.mapImage)}
            bookTitle={bookBySlug.get(chapter.data.bookSlug)?.data.title}
          />
        ))}
      </div>
    </div>
  </section>

  {analysisVideos.length > 0 && (
    <section class="section home-analysis-section">
      <div class="container">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Análises completas</p><h2>Veja o livro como um todo.</h2></div>
          <p class="muted section-intro">Os episódios completos conectam a sequência dos capítulos depois que você já percorreu — ou antes de começar — uma coleção.</p>
        </div>
        <div class="home-analysis-grid">
          {analysisVideos.map((item) => (
            <article class="home-analysis-card">
              <div class:list={['home-analysis-cover', item.book.data.accent === 'atomic' && 'is-atomic']}><img src={item.book.data.cover} alt={`Capa de ${item.book.data.title}`} loading="lazy" /></div>
              <div><small>{item.book.data.title}</small><h3>{item.video.title}</h3><p>{item.video.description}</p><a class="btn btn-secondary" href={item.video.url} target="_blank" rel="noopener noreferrer">Assistir no YouTube ↗</a></div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="manifesto-strip">
    <div class="container manifesto-inner">
      <span class="manifesto-mark" aria-hidden="true">EC</span>
      <div><p class="eyebrow">Entre Capítulos</p><h2>O vídeo passa. A biblioteca fica.</h2><p>Use o site como ponto de retorno para recuperar conceitos, mapas e conexões dos episódios.</p></div>
      <a class="btn btn-secondary" href="/sobre">Conhecer o projeto</a>
    </div>
  </section>
</BaseLayout>
